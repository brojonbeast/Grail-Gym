---
import "../styles/global.css";
import { site, pricing } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | 24 Hour Gym in San Antonio, TX (Rigsby Ave)`,
  description = `${site.name} is a 24 hour strength and bodybuilding gym at ${site.address.street}, San Antonio, TX ${site.address.zip}. Commercial-grade equipment, memberships from $${pricing.paidInFull.effectiveMonthly}/mo paid in full, military rates, and $${pricing.dayPass.price} day passes.`,
} = Astro.props;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthClub",
  name: site.name,
  description,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  image: new URL("/logo-gold.jpg", Astro.site).href,
  logo: new URL("/logo-full.png", Astro.site).href,
  priceRange: "$20 - $49.99",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 29.3977534,
    longitude: -98.4026659,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
  hasMap: site.reviews,
  sameAs: [site.instagram, site.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL("/logo-gold.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Self-hosted Proxima Nova -->
    <link
      rel="preload"
      href="/fonts/ProximaNovaBlack.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ProximaNovaRegular.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    <!-- Local business structured data (Google Maps / local SEO) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessSchema)}
    />

    <!-- TODO: paste Meta Pixel here for ad retargeting -->
  </head>
  <body>
    <slot />
  </body>
</html>
