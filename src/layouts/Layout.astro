---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — 24/7 Strength Gym in ${site.cityState}`,
  description = `${site.name} is a 24/7 bodybuilding gym in ${site.region}. Commercial-grade machines, no big-box crowds. Founding Members lock in the lowest price we'll ever offer — before we expand.`,
} = Astro.props;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthClub",
  name: site.name,
  description,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: "US",
  },
  openingHours: "Mo-Su 00:00-23:59",
  sameAs: [site.instagram, site.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <!-- TODO: add a real share image at public/og.jpg (1200×630) -->
    <meta property="og:image" content="/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Local business structured data (helps Google Maps / local SEO) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessSchema)}
    />

    <!-- TODO: paste Meta Pixel here for the founding-members ad retargeting -->
  </head>
  <body>
    <slot />
  </body>
</html>
