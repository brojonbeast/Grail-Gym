---
import Layout from "../layouts/Layout.astro";
import { site, pricing, equipmentBrands } from "../data/site";

const money = (n: number) => (n % 1 === 0 ? `$${n}` : `$${n.toFixed(2)}`);

// Real photos pulled from grailgymtx.com. Arsenal Strength has no photo yet.
const brandPhotos: Record<
  string,
  { src: string; alt: string; width: number; height: number }
> = {
  "Intek Strength": {
    src: "/equipment/intek.jpg",
    alt: "Intek Strength dumbbell rack at Grail Gym San Antonio",
    width: 900,
    height: 1200,
  },
  "Mega Mass": {
    src: "/equipment/mega-mass.jpg",
    alt: "Mega Mass plate-loaded machine at Grail Gym San Antonio",
    width: 900,
    height: 1004,
  },
  "Booty Builder": {
    src: "/equipment/booty-builder.jpg",
    alt: "Booty Builder glute machine at Grail Gym San Antonio",
    width: 900,
    height: 675,
  },
};

const faqs = [
  {
    q: "Where is Grail Gym located?",
    a: `Grail Gym is at ${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}, in southeast San Antonio off Rigsby Ave.`,
  },
  {
    q: "Is Grail Gym open 24 hours?",
    a: "Yes. Members have 24/7 access through the GymMaster door system and app. Day passes are valid on the day of purchase.",
  },
  {
    q: "How much does a membership cost?",
    a: `Month to month is ${money(pricing.monthToMonth.price)} per month with a ${money(pricing.monthToMonth.signupFee)} one-time signup fee. Six months paid in full is ${money(pricing.sixMonth.price)}. A year paid in full is ${money(pricing.paidInFull.price)}, which works out to ${money(pricing.paidInFull.effectiveMonthly)} per month with no signup fee.`,
  },
  {
    q: "Is there a military discount?",
    a: `Yes. Active duty and veterans pay ${money(pricing.military.price)} per month, or ${money(pricing.militaryPaidInFull.price)} for a full year, which works out to ${money(pricing.militaryPaidInFull.effectiveMonthly)} per month.`,
  },
  {
    q: "Can I try the gym without a membership?",
    a: `Yes. A day pass is ${money(pricing.dayPass.price)} and is valid on the day of purchase.`,
  },
  {
    q: "What equipment does Grail Gym have?",
    a: `Commercial-grade machines from ${equipmentBrands.join(", ")}, plus power racks, Olympic benches, and a full dumbbell range. Cardio equipment is being added.`,
  },
  {
    q: "How do I sign up?",
    a: "Sign up online through the member portal, or come by the gym. Every plan on this page links straight to the portal.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ===================== NAV ===================== -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-grail-card-edge bg-grail-ink">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <a href="#top" class="font-display text-xl tracking-wide">
        GRAIL<span class="text-grail-gold">GYM</span>
        <span class="ml-2 hidden text-xs font-normal tracking-widest text-grail-fog md:inline"
          >SAN ANTONIO, TX</span
        >
      </a>
      <div class="hidden items-center gap-7 text-sm text-grail-fog lg:flex">
        <a href="#about" class="transition hover:text-white">About</a>
        <a href="#equipment" class="transition hover:text-white">Equipment</a>
        <a href="#pricing" class="transition hover:text-white">Pricing</a>
        <a href="#training" class="transition hover:text-white">Training</a>
        <a href="#location" class="transition hover:text-white">Location</a>
        <a href="#faq" class="transition hover:text-white">FAQ</a>
      </div>
      <a href={site.joinUrl} class="btn btn-gold px-4 py-2 text-sm">Join Now</a>
    </nav>
  </header>

  <!-- ===================== HERO ===================== -->
  <section
    id="top"
    class="relative flex min-h-svh items-center pt-16 md:h-screen md:min-h-[44rem]"
  >
    <!-- Full-bleed photo background on tablet and desktop. -->
    <img
      src="/gym-floor.jpg"
      alt="Gym floor at Grail Gym San Antonio with plate-loaded squat and hack squat machines"
      width="1206"
      height="1149"
      class="absolute inset-0 hidden h-full w-full object-cover md:block"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 hidden bg-grail-ink/75 md:block"></div>

    <div
      class="relative mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 md:px-10"
    >
      <p
        class="inline-block border border-grail-card-edge px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-grail-gold md:border-grail-fog/40"
      >
        Now open at 4654 Rigsby Ave
      </p>
      <h1
        class="font-display mt-5 max-w-6xl text-4xl uppercase leading-[1.02] sm:text-6xl md:mt-8 md:text-7xl lg:text-8xl xl:text-[7.5rem] xl:leading-[0.98]"
      >
        A 24 hour bodybuilding gym in San Antonio, Texas.
      </h1>
      <p class="mt-6 max-w-xl text-base text-grail-fog sm:text-lg md:mt-8 md:max-w-2xl md:text-xl md:text-white">
        {site.name} is a strength and bodybuilding gym in southeast San
        Antonio. Commercial-grade machines, 24/7 member access, and room to
        train. Memberships start at {money(pricing.paidInFull.effectiveMonthly)}
        a month paid in full.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row md:mt-10">
        <a href={site.joinUrl} class="btn btn-gold px-7 py-3.5 md:px-9 md:py-4 md:text-lg">
          Sign Up at the Member Portal
        </a>
        <a href="#pricing" class="btn btn-outline px-7 py-3.5 md:px-9 md:py-4 md:text-lg">
          See Membership Pricing
        </a>
      </div>
      <p class="mt-5 text-sm text-grail-fog md:text-base md:text-white/80">
        Military rates from {money(pricing.militaryPaidInFull.effectiveMonthly)}/mo.
        Day passes {money(pricing.dayPass.price)}.
      </p>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section id="about" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-6 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-widest text-grail-gold">
          About Grail Gym
        </p>
        <p class="font-display mt-4 max-w-3xl text-xl leading-snug sm:text-2xl lg:text-3xl">
          {site.whyWeExist}
        </p>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          <div class="border border-grail-card-edge p-6">
            <h2 class="text-lg font-bold">Commercial-grade equipment</h2>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              The floor is stocked with machines from {equipmentBrands.join(", ")}.
              Equipment you can load heavy and trust every session.
            </p>
          </div>
          <div class="border border-grail-card-edge p-6">
            <h2 class="text-lg font-bold">24/7 member access</h2>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              Members enter any hour through the GymMaster door system. Train
              before work, after a night shift, or whenever your program calls
              for it.
            </p>
          </div>
          <div class="border border-grail-card-edge p-6">
            <h2 class="text-lg font-bold">Founding rates</h2>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              The gym is still growing. More machines and cardio are being
              added, and rates will rise as they arrive. Current members keep
              the rate they signed at.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FOUNDER ===================== -->
  <section id="story" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card grid gap-8 p-6 sm:p-10 md:grid-cols-[0.9fr_1.1fr] md:items-center">
        <!-- TODO: replace with a real photo of Hunter (public/hunter.jpg). -->
        <div
          class="flex aspect-[4/3] items-end border border-grail-card-edge bg-black p-6 md:aspect-[4/5]"
        >
          <p class="font-display text-2xl leading-tight">
            {site.owner}<span class="text-grail-gold">.</span><br />
            <span class="text-base font-normal text-grail-fog">Founder</span>
          </p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-grail-gold">
            Meet the founder
          </p>
          <h2 class="font-display mt-3 text-2xl sm:text-3xl lg:text-4xl">
            Built by a lifter who wanted his own gym.
          </h2>
          <p class="mt-4 leading-relaxed text-grail-fog">
            {site.owner} wanted to open a gym for as long as he can remember.
            Rather than wait for a polished grand opening, he opened the doors
            as soon as the floor was ready so people could train while the gym
            grows.
          </p>
          <p class="mt-4 leading-relaxed text-grail-fog">
            That is the reason founding rates exist. Join early, lock in the
            lowest price the gym will offer, and watch the equipment list get
            longer. The members here now are part of building the place.
          </p>
          <blockquote
            class="mt-6 border-l-2 border-grail-gold pl-5 font-display text-xl leading-snug"
          >
            "Be part of it while I'm building it."
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EQUIPMENT ===================== -->
  <section id="equipment" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-6 sm:p-10">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl">
          Gym equipment
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-grail-fog">
          Every machine on the floor is commercial grade. These are the brands
          you train on here.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
          {
            equipmentBrands.map((brand) => {
              const photo = brandPhotos[brand];
              return (
                <div class="relative flex aspect-[4/5] flex-col justify-end overflow-hidden border border-grail-card-edge bg-black p-4 sm:p-5">
                  {photo && (
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      width={photo.width}
                      height={photo.height}
                      class="absolute inset-0 h-full w-full object-cover"
                      loading="lazy"
                    />
                  )}
                  <span class="relative bg-grail-ink px-2 py-1 font-display text-base leading-tight sm:text-lg">
                    {brand}
                  </span>
                </div>
              );
            })
          }
        </div>

        <div class="mt-4 grid gap-3 sm:mt-6 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
          <div class="border border-grail-card-edge p-6">
            <h3 class="text-lg font-bold">Free weights and racks</h3>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              Full dumbbell range, Olympic benches, and power racks for squat,
              bench, and deadlift work.
            </p>
          </div>
          <div class="border border-grail-card-edge p-6">
            <h3 class="text-lg font-bold">Machines for every lift</h3>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              Plate-loaded strength machines, a linear row, hip thrust, and
              posterior chain equipment.
            </p>
          </div>
          <div class="relative border border-grail-gold/50 p-6">
            <span
              class="absolute right-4 top-4 bg-grail-gold px-2 py-1 text-xs font-bold text-grail-ink"
              >Coming soon</span
            >
            <h3 class="text-lg font-bold">Cardio</h3>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              Cardio equipment is on the way. Rates will rise once it lands, so
              joining before then locks the lower price.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section id="pricing" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-6 sm:p-10">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl">
          Membership pricing
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-grail-fog">
          Every plan includes 24/7 access to all equipment. Pick the term that
          fits and sign up at the member portal.
        </p>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <!-- Month to month -->
          <div class="flex flex-col border border-grail-card-edge p-6">
            <h3 class="font-display text-xl">{pricing.monthToMonth.label}</h3>
            <div class="mt-4 flex items-end gap-1">
              <span class="font-display text-4xl sm:text-5xl"
                >{money(pricing.monthToMonth.price)}</span
              >
              <span class="mb-1 text-grail-fog">{pricing.monthToMonth.period}</span>
            </div>
            <p class="mb-6 mt-3 text-sm leading-relaxed text-grail-fog">
              {pricing.monthToMonth.note} Cancel anytime.
            </p>
            <a
              href={site.planUrls.monthToMonth}
              class="btn btn-outline mt-auto px-6 py-3 text-sm"
              >Start month to month</a
            >
          </div>

          <!-- 6 months -->
          <div class="flex flex-col border border-grail-card-edge p-6">
            <h3 class="font-display text-xl">{pricing.sixMonth.label}</h3>
            <div class="mt-4 flex items-end gap-1">
              <span class="font-display text-4xl sm:text-5xl"
                >{money(pricing.sixMonth.price)}</span
              >
              <span class="mb-1 text-grail-fog">{pricing.sixMonth.period}</span>
            </div>
            <p class="mb-6 mt-3 text-sm leading-relaxed text-grail-fog">
              {money(pricing.sixMonth.effectiveMonthly)} per month.
              {pricing.sixMonth.note}
            </p>
            <a
              href={site.planUrls.sixMonth}
              class="btn btn-outline mt-auto px-6 py-3 text-sm"
              >Start 6 months</a
            >
          </div>

          <!-- 1 year featured -->
          <div class="relative flex flex-col border-2 border-grail-gold p-6">
            <span
              class="absolute -top-3 left-6 bg-grail-gold px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-grail-ink"
              >Lowest rate</span
            >
            <h3 class="font-display text-xl">{pricing.paidInFull.label}</h3>
            <div class="mt-4 flex items-end gap-1">
              <span class="font-display text-4xl text-grail-gold sm:text-5xl"
                >{money(pricing.paidInFull.price)}</span
              >
              <span class="mb-1 text-grail-fog">{pricing.paidInFull.period}</span>
            </div>
            <p class="mb-6 mt-3 text-sm leading-relaxed text-grail-fog">
              {pricing.paidInFull.note} Saves {money(pricing.paidInFull.savingsWithSignup)}
              in year one compared to month to month.
            </p>
            <a
              href={site.planUrls.paidInFull}
              class="btn btn-gold mt-auto px-6 py-3 text-sm"
              >Start the year plan</a
            >
          </div>
        </div>

        <!-- Military -->
        <div
          class="mt-4 grid gap-5 border border-grail-card-edge p-6 sm:grid-cols-[1fr_auto] sm:items-center"
        >
          <div>
            <h3 class="font-display text-lg">
              Military rate <span class="text-grail-gold">for active duty and veterans</span>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-grail-fog">
              {money(pricing.military.price)} per month, or {money(pricing.militaryPaidInFull.price)}
              for a year paid in full, which works out to {money(
                pricing.militaryPaidInFull.effectiveMonthly
              )} per month.
            </p>
          </div>
          <a href={site.joinUrl} class="btn btn-outline px-6 py-3 text-sm"
            >Start military plan</a
          >
        </div>

        <p class="mt-6 text-sm text-grail-fog">
          Visiting San Antonio or want to try the gym first? A day pass is
          <span class="font-bold text-white">{money(pricing.dayPass.price)}</span>,
          valid on the day of purchase, and a week pass is
          <span class="font-bold text-white">{money(pricing.weekPass.price)}</span>
          for seven days of access.
          <a
            href={site.planUrls.dayPass}
            class="text-grail-gold underline underline-offset-4"
            >Get a day pass</a
          >
          or
          <a
            href={site.planUrls.weekPass}
            class="text-grail-gold underline underline-offset-4"
            >get a week pass</a
          >
          at the portal.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== PERSONAL TRAINING ===================== -->
  <section id="training" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div
        class="card flex flex-col gap-6 p-6 sm:p-10 md:flex-row md:items-center md:justify-between"
      >
        <div class="max-w-xl">
          <p class="text-xs font-bold uppercase tracking-widest text-grail-gold">
            Personal training
          </p>
          <h2 class="font-display mt-3 text-2xl sm:text-3xl lg:text-4xl">
            Coaching in an uncrowded gym.
          </h2>
          <p class="mt-4 leading-relaxed text-grail-fog">
            Trainers at {site.name} program for fat loss, muscle gain, and
            strength. Independent coaches are welcome to train their own
            clients here. Fill out the form and a coach will contact you.
          </p>
        </div>
        <a href={site.trainingFormUrl} class="btn btn-gold shrink-0 px-7 py-3.5"
          >Request a consultation</a
        >
      </div>
    </div>
  </section>

  <!-- ===================== VIDEOS ===================== -->
  <section id="videos" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-6 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-widest text-grail-gold">
          Videos
        </p>
        <h2 class="font-display mt-3 text-2xl sm:text-3xl lg:text-4xl">
          See the gym in motion
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-grail-fog">
          Walkthroughs and training footage from Instagram. Follow
          <a
            href={site.instagram}
            class="text-grail-gold underline underline-offset-4"
            rel="noopener"
            target="_blank">{site.instagramHandle}</a
          > for more.
        </p>

        <div class="mt-8 grid justify-items-center gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            site.instagramReels.map((url) => (
              <blockquote
                class="instagram-media w-full"
                data-instgrm-captioned
                data-instgrm-permalink={`${url}?utm_source=ig_embed&utm_campaign=loading`}
                data-instgrm-version="14"
                style="background:#FFF; border:0; border-radius:3px; margin:1px; max-width:540px; min-width:280px; padding:0; width:calc(100% - 2px);"
              >
                <a href={url} rel="noopener" target="_blank">
                  View this reel on Instagram
                </a>
              </blockquote>
            ))
          }
        </div>
        <script async is:inline src="https://www.instagram.com/embed.js"></script>
      </div>
    </div>
  </section>

  <!-- ===================== LOCATION ===================== -->
  <section id="location" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-6 sm:p-10">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl">
          Location and hours
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-grail-fog">
          The gym is in southeast San Antonio on Rigsby Ave. Members get in
          24/7. Sign up online or at the door.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-grail-gold">
              Address
            </h3>
            <p class="mt-2 leading-relaxed">
              {site.address.street}<br />
              {site.address.city}, {site.address.state} {site.address.zip}
            </p>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-grail-gold">
              Hours
            </h3>
            <p class="mt-2 leading-relaxed">{site.hours}</p>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-grail-gold">
              Contact
            </h3>
            <p class="mt-2 leading-relaxed">
              <a class="hover:text-grail-gold" href={site.phoneHref}>{site.phone}</a><br />
              <a class="hover:text-grail-gold" href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <a href={site.reviews} class="btn btn-outline px-5 py-2.5">Google reviews</a>
          <a href={site.instagram} class="btn btn-outline px-5 py-2.5">Instagram</a>
          <a href={site.facebook} class="btn btn-outline px-5 py-2.5">Facebook</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section id="faq" class="scroll-mt-20 py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-6 sm:p-10">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl">
          Frequently asked questions
        </h2>
        <div class="mt-8 space-y-3">
          {
            faqs.map((f) => (
              <details class="border border-grail-card-edge p-5">
                <summary class="cursor-pointer list-none font-bold marker:hidden">
                  {f.q}
                </summary>
                <p class="mb-6 mt-3 text-sm leading-relaxed text-grail-fog">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="py-8 sm:py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card p-8 text-center sm:p-12">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl">
          Ready to train?
        </h2>
        <p class="mx-auto mt-4 max-w-xl leading-relaxed text-grail-fog">
          Sign up online in a few minutes, or come see the gym at
          {site.address.street.split(",")[0]}. Founding rates apply while the
          gym is still building out.
        </p>
        <a href={site.joinUrl} class="btn btn-gold mt-8 px-9 py-4">
          Sign Up at the Member Portal
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="mt-8 border-t border-grail-card-edge">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="grid gap-8 md:grid-cols-2 md:items-start">
        <div>
          <p class="font-display text-lg">
            GRAIL<span class="text-grail-gold">GYM</span>
            <span class="ml-2 text-xs font-normal tracking-widest text-grail-fog"
              >SAN ANTONIO, TX</span
            >
          </p>
          <p class="mt-2 text-sm leading-relaxed text-grail-fog">
            {site.address.street}, {site.address.city}, {site.address.state}
            {site.address.zip}<br />
            {site.hours}
          </p>
          <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-grail-fog">
            <a href={site.phoneHref} class="transition hover:text-white">{site.phone}</a>
            <a href={site.instagram} class="transition hover:text-white">{site.instagramHandle}</a>
            <a href={site.joinUrl} class="transition hover:text-white">Member Portal</a>
          </div>
        </div>
        <div class="card overflow-hidden bg-black p-0">
          <iframe
            src={site.mapEmbedSrc}
            title={`Google Maps location of ${site.name}, ${site.address.street}, San Antonio TX`}
            class="h-72 w-full sm:h-80"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <p class="mt-8 text-center text-xs text-grail-fog/60">
        © {new Date().getFullYear()} {site.name}. {site.address.street}, {site.address.city},
        {site.address.state} {site.address.zip}. Open 24/7 for members.
      </p>
    </div>
  </footer>
</Layout>
