---
import Layout from "../layouts/Layout.astro";
import { site, pricing, equipmentBrands } from "../data/site";

const money = (n: number) => (n % 1 === 0 ? `$${n}` : `$${n.toFixed(2)}`);
---

<Layout>
  <!-- ===================== NAV ===================== -->
  <header
    class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-grail-ink/80 backdrop-blur"
  >
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="#top" class="font-display text-xl font-bold tracking-wide">
        GRAIL<span class="text-grail-gold">GYM</span>
        <span class="ml-2 hidden text-xs font-medium tracking-widest text-grail-fog sm:inline"
          >SAN ANTONIO, TX</span
        >
      </a>
      <div class="hidden items-center gap-8 text-sm font-medium text-grail-fog md:flex">
        <a href="#why" class="transition hover:text-white">Why Grail</a>
        <a href="#equipment" class="transition hover:text-white">Equipment</a>
        <a href="#pricing" class="transition hover:text-white">Pricing</a>
        <a href="#training" class="transition hover:text-white">Training</a>
        <a href="#visit" class="transition hover:text-white">Visit</a>
      </div>
      <a
        href={site.joinUrl}
        class="rounded-md bg-grail-gold px-4 py-2 text-sm font-bold text-grail-ink transition hover:bg-grail-gold-bright"
      >
        Join Now
      </a>
    </nav>
  </header>

  <!-- ===================== HERO ===================== -->
  <section
    id="top"
    class="relative flex min-h-screen items-center overflow-hidden pt-20"
  >
    <!-- TODO: drop a real interior/owner photo behind this (public/hero.jpg).
         Best source: still from IG reel DZtvOu6t-jJ or photo DZSxpVKJKZp. -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-grail-charcoal via-grail-ink to-grail-ink"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-grail-gold/10 blur-3xl"
    >
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-5 py-20">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-grail-gold/40 bg-grail-gold/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-grail-gold"
      >
        ● Now open · Limited founding memberships
      </span>
      <h1
        class="font-display mt-6 max-w-3xl text-5xl font-bold leading-[1.05] sm:text-6xl md:text-7xl"
      >
        Serious iron.<br />No crowds. Open 24/7.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-grail-fog">
        A new bodybuilding gym in southeast San Antonio with commercial-grade
        machines and a raw place to train. This is just the start — and Founding
        Members lock in the lowest price we will ever offer.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.joinUrl}
          class="rounded-md bg-grail-gold px-7 py-3.5 text-center font-bold text-grail-ink transition hover:bg-grail-gold-bright"
        >
          Become a Founding Member
        </a>
        <a
          href="#pricing"
          class="rounded-md border border-white/15 px-7 py-3.5 text-center font-semibold text-white transition hover:border-white/40"
        >
          See Pricing
        </a>
      </div>
      <p class="mt-5 text-sm text-grail-fog">
        From <span class="font-bold text-white">$40/mo</span> paid in full · Military
        from <span class="font-bold text-white">$30/mo</span> · {site.address.street.split(",")[0]},
        SATX
      </p>
    </div>
  </section>

  <!-- ===================== WHY WE EXIST ===================== -->
  <section id="why" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-5">
      <span class="text-xs font-semibold uppercase tracking-widest text-grail-gold"
        >Why we exist</span
      >
      <p class="mt-5 max-w-3xl font-display text-2xl leading-snug sm:text-3xl">
        {site.whyWeExist}
      </p>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-grail-charcoal p-7">
          <h3 class="text-lg font-bold">Commercial-grade only</h3>
          <p class="mt-2 text-sm text-grail-fog">
            We didn't cut corners. Real machines from {equipmentBrands.join(", ")}
            — built to train hard on from day one.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-grail-charcoal p-7">
          <h3 class="text-lg font-bold">24/7, no crowds</h3>
          <p class="mt-2 text-sm text-grail-fog">
            Member access around the clock through the GymMaster door system.
            Train on your schedule, without the big-box wait.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-grail-charcoal p-7">
          <h3 class="text-lg font-bold">Get in early</h3>
          <p class="mt-2 text-sm text-grail-fog">
            We're adding more machines — and cardio is on the way. As the gym
            grows, prices go up. Founding Members keep their rate.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EQUIPMENT ===================== -->
  <section id="equipment" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">High-quality equipment</h2>
      <p class="mt-4 max-w-2xl text-grail-fog">
        Commercial-grade bodybuilding equipment from the brands serious lifters
        ask for — with more on the way.
      </p>

      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          equipmentBrands.map((brand) => (
            <div class="flex aspect-[4/3] flex-col justify-end rounded-xl border border-white/10 bg-grail-charcoal p-5">
              {/* TODO: add real equipment photo per brand (public/equipment/) */}
              <span class="font-display text-lg font-bold leading-tight">
                {brand}
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-grail-charcoal p-7">
          <h3 class="text-lg font-bold">Free weights &amp; racks</h3>
          <p class="mt-2 text-sm text-grail-fog">
            Full dumbbell range, Olympic benches, and power/squat racks — the
            staples, done right.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-grail-charcoal p-7">
          <h3 class="text-lg font-bold">Machines for every lift</h3>
          <p class="mt-2 text-sm text-grail-fog">
            Plate-loaded strength machines, a linear row "beast," hip-thrust, and
            posterior-chain work covered.
          </p>
        </div>
        <div
          class="relative rounded-xl border border-dashed border-grail-gold/40 bg-grail-gold/5 p-7"
        >
          <span
            class="absolute right-5 top-5 rounded-full bg-grail-gold px-2.5 py-1 text-xs font-bold text-grail-ink"
            >Coming soon</span
          >
          <h3 class="text-lg font-bold">Cardio</h3>
          <p class="mt-2 text-sm text-grail-fog">
            Cardio is on the way — one more piece of the build, and one more
            reason today's founding price won't last.
          </p>
        </div>
      </div>
      <p class="mt-8 font-display text-xl tracking-wide text-grail-fog">
        . . . AND MORE TO COME
      </p>
      <!-- TODO: add a real photo gallery here from @grailgym (owner to send source files). -->
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section id="pricing" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Founding Member pricing
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-grail-fog">
          Lock today's rate before we expand. Pay monthly, or pay the year in
          full and save.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        <!-- Month to month -->
        <div class="flex flex-col rounded-2xl border border-white/10 bg-grail-charcoal p-8">
          <h3 class="font-display text-2xl font-bold">{pricing.monthToMonth.label}</h3>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-display text-5xl font-bold"
              >{money(pricing.monthToMonth.price)}</span
            >
            <span class="mb-1.5 text-grail-fog">{pricing.monthToMonth.period}</span>
          </div>
          <p class="mt-2 text-sm text-grail-fog">{pricing.monthToMonth.note}</p>
          <ul class="mt-6 space-y-2 text-sm text-grail-fog">
            <li>✓ Full 24/7 access to all equipment</li>
            <li>✓ Founding rate locked while you stay</li>
            <li>✓ No contract — cancel anytime</li>
          </ul>
          <a
            href={site.joinUrl}
            class="mt-8 rounded-md border border-white/15 px-6 py-3 text-center font-semibold transition hover:border-white/40"
            >Start month-to-month</a
          >
        </div>

        <!-- Paid in full — featured -->
        <div
          class="relative flex flex-col rounded-2xl border-2 border-grail-gold bg-gradient-to-b from-grail-gold/10 to-grail-charcoal p-8"
        >
          <span
            class="absolute -top-3 left-8 rounded-full bg-grail-gold px-3 py-1 text-xs font-bold uppercase tracking-wide text-grail-ink"
            >Best value</span
          >
          <h3 class="font-display text-2xl font-bold">{pricing.paidInFull.label}</h3>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-display text-5xl font-bold text-grail-gold"
              >{money(pricing.paidInFull.price)}</span
            >
            <span class="mb-1.5 text-grail-fog">{pricing.paidInFull.period}</span>
          </div>
          <p class="mt-2 text-sm font-semibold text-grail-gold">
            That's just {money(pricing.paidInFull.effectiveMonthly)}/mo — and no sign-up fee.
          </p>
          <div class="mt-5 rounded-lg border border-grail-gold/30 bg-grail-ink/40 p-4 text-sm">
            <p class="font-bold text-white">
              Save {money(pricing.paidInFull.savingsWithSignup)} in year one
            </p>
            <p class="mt-1 text-grail-fog">
              vs. {money(pricing.monthToMonth.price)}/mo ({money(
                pricing.monthToMonth.price * 12
              )} in dues) plus the {money(pricing.monthToMonth.signupFee)} sign-up fee.
            </p>
          </div>
          <ul class="mt-6 space-y-2 text-sm text-grail-fog">
            <li>✓ Everything in month-to-month</li>
            <li>✓ Sign-up fee waived</li>
            <li>✓ Lowest effective rate we offer</li>
          </ul>
          <a
            href={site.joinUrl}
            class="mt-8 rounded-md bg-grail-gold px-6 py-3 text-center font-bold text-grail-ink transition hover:bg-grail-gold-bright"
            >Pay the year in full</a
          >
        </div>
      </div>

      <!-- Military -->
      <div
        class="mt-6 grid gap-6 rounded-2xl border border-white/10 bg-grail-charcoal p-8 sm:grid-cols-[1fr_auto] sm:items-center"
      >
        <div>
          <h3 class="font-display text-xl font-bold">
            Military <span class="text-grail-gold">— thank you for your service</span>
          </h3>
          <p class="mt-2 text-sm text-grail-fog">
            Active duty &amp; veterans: {money(pricing.military.price)}/mo, or pay
            the year in full for {money(pricing.militaryPaidInFull.price)}
            (just {money(pricing.militaryPaidInFull.effectiveMonthly)}/mo) — sign-up
            fee waived. <!-- TODO: confirm military sign-up fee is waived. -->
          </p>
        </div>
        <a
          href={site.joinUrl}
          class="rounded-md border border-grail-gold/50 px-6 py-3 text-center font-bold text-grail-gold transition hover:bg-grail-gold hover:text-grail-ink"
          >Claim military rate</a
        >
      </div>

      <p class="mt-6 text-center text-sm text-grail-fog">
        Just visiting? Grab a <span class="font-semibold text-white"
          >{money(pricing.dayPass.price)} day pass</span
        > — {pricing.dayPass.note.toLowerCase()}. Prices shown before applicable tax.
      </p>
    </div>
  </section>

  <!-- ===================== PERSONAL TRAINING ===================== -->
  <section id="training" class="border-t border-white/5 py-24">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-grail-gold"
          >Personal training</span
        >
        <h2 class="font-display mt-4 text-3xl font-bold sm:text-4xl">
          Train with a coach — in a private, uncrowded space.
        </h2>
        <p class="mt-4 text-grail-fog">
          Whether your goal is fat loss, muscle gain, or just getting stronger,
          our trainers will build the plan. Bring your own clients, too — coaches
          are welcome to train them here.
        </p>
      </div>
      <a
        href={site.trainingFormUrl}
        class="shrink-0 rounded-md bg-grail-gold px-7 py-3.5 text-center font-bold text-grail-ink transition hover:bg-grail-gold-bright"
        >Book a consultation</a
      >
    </div>
  </section>

  <!-- ===================== VISIT / LOCATION ===================== -->
  <section id="visit" class="border-t border-white/5 py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold sm:text-4xl">Come train</h2>
        <p class="mt-4 text-grail-fog">
          We're in southeast San Antonio. Members get in 24/7 — stop by for a
          day pass or sign up online and start today.
        </p>
        <dl class="mt-8 space-y-5 text-sm">
          <div>
            <dt class="font-semibold uppercase tracking-widest text-grail-gold">Address</dt>
            <dd class="mt-1 text-lg">
              {site.address.street}<br />
              {site.address.city}, {site.address.state} {site.address.zip}
            </dd>
          </div>
          <div>
            <dt class="font-semibold uppercase tracking-widest text-grail-gold">Hours</dt>
            <dd class="mt-1 text-lg">{site.hours}</dd>
          </div>
          <div>
            <dt class="font-semibold uppercase tracking-widest text-grail-gold">Contact</dt>
            <dd class="mt-1 text-lg">
              <a class="hover:text-grail-gold" href={site.phoneHref}>{site.phone}</a><br />
              <a class="hover:text-grail-gold" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <a href={site.reviews} class="rounded-md border border-white/15 px-5 py-2.5 font-semibold transition hover:border-white/40">Google reviews</a>
          <a href={site.instagram} class="rounded-md border border-white/15 px-5 py-2.5 font-semibold transition hover:border-white/40">Instagram</a>
          <a href={site.facebook} class="rounded-md border border-white/15 px-5 py-2.5 font-semibold transition hover:border-white/40">Facebook</a>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-white/10">
        <iframe
          title={`Map to ${site.name}`}
          class="h-full min-h-[340px] w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://www.google.com/maps?q=${encodeURIComponent(
            `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`
          )}&output=embed`}></iframe>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Questions</h2>
      <div class="mt-10 space-y-4">
        <details class="rounded-xl border border-white/10 bg-grail-charcoal p-6">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            What's the catch with "founding member" pricing?
          </summary>
          <p class="mt-3 text-sm text-grail-fog">
            No catch. We're a brand-new gym that's still growing. As we add more
            machines and cardio, prices will go up — but your founding rate stays
            locked while your membership is active.
          </p>
        </details>
        <details class="rounded-xl border border-white/10 bg-grail-charcoal p-6">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            Is it really open 24/7?
          </summary>
          <p class="mt-3 text-sm text-grail-fog">
            Yes — members get 24/7 access through the GymMaster door system and
            app. Day passes are usable the day of purchase during open hours.
          </p>
        </details>
        <details class="rounded-xl border border-white/10 bg-grail-charcoal p-6">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            Is there cardio equipment?
          </summary>
          <p class="mt-3 text-sm text-grail-fog">
            Not yet — it's on the way. Right now the floor is built around serious
            strength training: commercial-grade machines, racks, and a full
            dumbbell range.
          </p>
        </details>
        <details class="rounded-xl border border-white/10 bg-grail-charcoal p-6">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            How do I sign up?
          </summary>
          <p class="mt-3 text-sm text-grail-fog">
            Hit any “Join” button — it takes you straight to our member portal to
            pick your plan and start training. You can also sign up at the door.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-4xl px-5 text-center">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">
        The price only goes up from here.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-grail-fog">
        Memberships are limited. Be one of the names that was here first — lock
        your founding rate today.
      </p>
      <a
        href={site.joinUrl}
        class="mt-9 inline-block rounded-md bg-grail-gold px-9 py-4 font-bold text-grail-ink transition hover:bg-grail-gold-bright"
      >
        Become a Founding Member
      </a>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="border-t border-white/5 py-12">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="font-display text-lg font-bold">
          GRAIL<span class="text-grail-gold">GYM</span>
          <span class="ml-2 text-xs font-medium tracking-widest text-grail-fog"
            >SAN ANTONIO, TX</span
          >
        </p>
        <p class="mt-1 text-sm text-grail-fog">
          {site.address.street}, {site.address.city}, {site.address.state}
          {site.address.zip} · {site.hours}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-grail-fog">
        <a href={site.phoneHref} class="transition hover:text-white">{site.phone}</a>
        <a href={site.instagram} class="transition hover:text-white">{site.instagramHandle}</a>
        <a href={site.joinUrl} class="transition hover:text-white">Member Portal</a>
      </div>
    </div>
    <p class="mt-8 text-center text-xs text-grail-fog/60">
      © {new Date().getFullYear()} {site.name}. {site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}.
    </p>
  </footer>
</Layout>
